{
  "name": "homesense",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "services/*",
    "adapters/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dashboard": "npm run dev --workspace=@homesense/dashboard",
    "firetv": "npm run dev --workspace=@homesense/firetv",
    "alexa": "npm run dev --workspace=@homesense/alexa-sim",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
