# HomeGuard / HomeSense — environment overrides
# Copy to .env if you need non-default ports. No secrets are required for the local demo.

# MCP server (services/homeguard-mcp)
MCP_PORT=3000

# Frontends talk to the MCP endpoint below (defaults are hard-coded for the hackathon demo).
# VITE_MCP_URL=http://localhost:3000/mcp

# Dashboard / Fire TV / Alexa sim Vite ports (change via each app's vite config if needed)
# Dashboard: 5173
# Fire TV:   5174
# Alexa sim: 5175
